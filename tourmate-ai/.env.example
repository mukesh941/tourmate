# PostgreSQL + pgvector Database Configuration
POSTGRES_DB=tourmate
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://postgres:your_secure_password_here@localhost:5432/tourmate

# JWT Security Configuration
JWT_SECRET_KEY=change-me-super-secret-at-least-32-chars
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Networking & CORS
CORS_ORIGINS=http://localhost:5173
GEMINI_API_KEY=your-gemini-api-key-here

# Google Maps Platform (Required for AI Cluster Map)
# Enable: Maps JavaScript API, Places API (New), Routes API
GOOGLE_MAPS_API_KEY=your-google-maps-api-key-here

# AI & Third-Party APIs (Optional)
GEMINI_API_KEY=your_gemini_api_key_here

# Frontend
VITE_API_BASE_URL=http://localhost:8000/api
VITE_GOOGLE_MAPS_API_KEY=your-google-maps-api-key-here
