# Neon PostgreSQL + pgvector Database Configuration
# Copy your connection string directly from Neon console (works with both pooled and direct connection):
# e.g.: postgresql://neondb_owner:password@ep-xyz-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://neondb_owner:your_password_here@ep-xyz.us-east-2.aws.neon.tech/neondb?sslmode=require

# JWT Security Configuration
JWT_SECRET_KEY=generate-a-strong-random-secret-key-32-chars
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Networking & CORS (Set your Vercel URL and local development origins)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://*.vercel.app

# AI & Third-Party APIs (Optional)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
