# PostgreSQL + pgvector Database Configuration
DATABASE_URL=postgresql+asyncpg://postgres:your_secure_password_here@localhost:5432/tourmate

# Backward-compatible MongoDB Configuration (Optional during transition)
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGO_DB_NAME=tourmate

# JWT Security Configuration
JWT_SECRET_KEY=generate-a-strong-random-secret-key-32-chars
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Networking & CORS
CORS_ORIGINS=https://tourmate-frontend.vercel.app,http://localhost:5173

# AI & Third-Party APIs (Optional)
GEMINI_API_KEY=your_gemini_api_key_here
