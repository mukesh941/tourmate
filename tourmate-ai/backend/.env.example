# Production MongoDB Atlas connection string
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGO_DB_NAME=tourmate

# JWT Authentication
JWT_SECRET_KEY=generate-a-strong-random-secret-key-32-chars
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Comma-separated allowed CORS origins (e.g. Vercel frontend domain)
CORS_ORIGINS=https://tourmate-frontend.vercel.app,http://localhost:5173

# Optional: Google Gemini AI API Key for landmark recognition and AI chatbot
GEMINI_API_KEY=your_gemini_api_key_here
